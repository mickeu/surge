#!name=断线重连与定时巡检
#!desc=断线自动重连 + 定时巡检（同一脚本 v8 双触发）：自动检测所有"叶子 select 组"（不写死组名/数量，适配任意策略组配置）。v6 约束智能判定：MTProto 未开 ipv6 时自动不锁 v6 节点；需要锁定时自动实测候选节点的 v6 能力（无需手写 V6_NODES）。仅在真正切换节点时推送通知。可选 $argument 覆盖：V6_ONLY_GROUPS=需要锁 v6 的组(逗号分隔)、V6_NODES=手动指定 v6 节点(逗号分隔，不传则自动检测)。
#!author=mickeu
#!category=mickeu
#!update-url=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/AutoReconnect/auto-reconnect.sgmodule

[Script]
# > 断线重连：网络变化（切换 Wi-Fi/蜂窝）时触发，等待 3 秒网络稳定后巡检所有叶子 select 组
# > argument 只声明"哪些组锁 v6"，v6 节点名单由脚本自动实测（MTProto 未开 ipv6 时锁定自动失效）
# > ?v=8 强制刷新：3819 下旧资源条目 update 为假更新，加参数换新条目（勿删）
断线重连 = type=event,event-name=network-changed,timeout=120,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/AutoReconnect/auto-reconnect.js?v=8,argument="V6_ONLY_GROUPS=Telegram",script-update-interval=86400
# > 定时巡检：每 30 分钟兜底（Wi-Fi 连着但节点静默挂掉时不触发 network-changed，靠它兜底）
定时巡检 = type=cron,cronexp="0 */30 * * *",timeout=120,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/AutoReconnect/auto-reconnect.js?v=8,argument="V6_ONLY_GROUPS=Telegram",script-update-interval=86400