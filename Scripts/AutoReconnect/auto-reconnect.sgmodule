#!name=断线重连与定时巡检
#!desc=断线自动重连 + 定时巡检（同一脚本 v7 双触发）：自动检测所有"叶子 select 组"（不写死组名/数量，适配任意策略组配置）。network-changed 触发立即处理；每 30 分钟 cron 兜底巡检，覆盖节点静默挂掉场景。仅在真正切换节点时推送通知。可选参数（通过挂载行 argument 传入）：V6_ONLY_GROUPS=必须走 v6 节点的组(逗号分隔)、V6_NODES=支持 v6 的节点(逗号分隔)。不带参数即纯通用版。
#!author=mickeu
#!update-url=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/AutoReconnect/auto-reconnect.sgmodule

[Script]
# > 断线重连：网络变化（切换 Wi-Fi/蜂窝）时触发，等待 3 秒网络稳定后巡检所有叶子 select 组
# > 下方 argument 为 v6 约束（Telegram 必须走 v6 节点）：不需要可整段删除
# > ?v=8 强制刷新：3819 下旧资源条目 update 为假更新，加参数换新条目（勿删）
断线重连 = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/AutoReconnect/auto-reconnect.js?v=8,argument="V6_ONLY_GROUPS=Telegram&V6_NODES=🇯🇵日本,🇸🇬新加坡",script-update-interval=86400
# > 定时巡检：每 30 分钟兜底（Wi-Fi 连着但节点静默挂掉时不触发 network-changed，靠它兜底）
定时巡检 = type=cron,cronexp="0 */30 * * *",timeout=120,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/AutoReconnect/auto-reconnect.js?v=8,argument="V6_ONLY_GROUPS=Telegram&V6_NODES=🇯🇵日本,🇸🇬新加坡",script-update-interval=86400