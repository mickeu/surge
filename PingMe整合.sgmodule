#!name=PingMe 签到整合版
#!desc=🔄 整合 PingMe 抓Cookie + 签到 + 视频奖励，支持策略组参数，一个模块搞定\n更新时间：2026.10.09 16:10｜超时重试版 v1
#!icon=https://raw.githubusercontent.com/axhani/icon/refs/heads/main/pingme&wetalk.png
#!system=ios
#!author=mickeu
#!category=mickeu
#!arguments=capture:true,PingMePolicy:PROXY,cron:0 */3 * * *
#!arguments-desc=\n📌 参数说明\n\n1️⃣ capture 抓Cookie开关\n默认 true 开启抓参；设 false 关闭抓参\n\n2️⃣ PingMePolicy PingMe流量策略\n指定 api.pingmeapp.net 请求走哪个策略组（如 PROXY / AIGC / DIRECT）\n默认 PROXY\n\n3️⃣ cron 签到定时\ncron 表达式，默认 "0 */3 * * *"（每3小时）\n\n每运行一次签到脚本自动生成随机设备ID防检测\n\n修改者：mickeu

[Rule]
DOMAIN-SUFFIX,api.pingmeapp.net,{{{PingMePolicy}}}

[Script]
# 抓 Cookie（http-request，拦截余额查询自动抓参，参数会明文写入 Surge 存储）
PingMe获取签到参数 = type=http-request,pattern=^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/PingMe/pingme_capture.js?v=20261002,argument="capture={{{capture}}}",timeout=60,script-update-interval=-1
# 签到+视频奖励（cron 定时任务，默认每3小时）
PingMe签到 = type=cron,cronexp="{{{cron}}}",script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/PingMe/SigninRetry_v1.js,timeout=300,wake-system=true,script-update-interval=-1
# 面板签到（点击面板执行完整签到，面板显示最新余额摘要）
PingMe签到面板 = type=generic,timeout=180,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/PingMe/PanelSigninRetry_v1.js,script-update-interval=-1

[Panel]
PingMe签到面板 = script-name=PingMe签到面板,title="🔄 PingMe 签到",content="运行签到",style=info,update-interval=0

[MITM]
hostname = %APPEND% api.pingmeapp.net