#!name=IP 纯净度检测
#!desc=检测指定策略组当前选中节点的出口 IP 纯净度（IP 类型/风险/评分）
#!arguments=group,策略组名称,默认填 PROXY

[Script]
IP-Quality = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/IP-Quality.js, argument=group=PROXY, script-update-interval=0

[Panel]
IP-Quality = script-name=IP-Quality,title="IP 纯净度",content="点击刷新",style=info,update-interval=0
