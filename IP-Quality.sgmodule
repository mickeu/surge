#!name=IP 纯净度检测
#!desc=多源并发检测指定策略组节点的出口 IP 纯净度（规则法，RULE-SET 控制检测域名走指定策略组）。ip-api/ipinfo/ipwho/ip.sb 多源交叉验证，面板精简+通知完整。
#!author=mickeu
#!category=mickeu
#!icon=https://raw.githubusercontent.com/Limexm/ClashXiOn/master/icons/Checkmark.png
#!homepage=https://github.com/mickeu/surge
#!arguments=GROUP:PROXY
#!arguments-desc=要检测的策略组名称（默认 PROXY）。输入目标策略组名（如 PROXY、AIGC、Netflix 等），改完 reload 生效。所有 IP 检测域名走你填的策略组。

[Rule]
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/IPCheck.list?v=2,{{{GROUP}}}

[Script]
IP-Quality = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/IP-Quality.js,script-update-interval=0,argument=group={{{GROUP}}}

[Panel]
IP-Quality = script-name=IP-Quality,title="IP 纯净度",content="点击刷新",style=info,update-interval=0
