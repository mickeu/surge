#!name=微信广告嗅探 v2
#!desc=嗅探朋友圈/公众号评论区/小程序广告API接口，扫描响应体关键字后通知
#!author=mickeu
#!category=mickeu
#!version=2.0
#!updated=2026-09-02
#!platform=ios
#!tag=

[MITM]
hostname = fpf.friendfeed.qq.com, friendfeed.qq.com, res.wx.qq.com, api.weixin.qq.com, mp.weixin.qq.com, servicewechat.com, sh.servicewechat.com, wx.qq.com, video.qq.com, finderad.video.qq.com, finderyz.video.qq.com, finderaly.video.qq.com, findera4.video.qq.com, findermp.video.qq.com, wxa.wxs.qq.com, mmbiz.qpic.cn

[Rule]
DOMAIN-SUFFIX,fpf.friendfeed.qq.com,DIRECT
DOMAIN-SUFFIX,friendfeed.qq.com,DIRECT
DOMAIN-SUFFIX,res.wx.qq.com,DIRECT
DOMAIN-SUFFIX,api.weixin.qq.com,DIRECT
DOMAIN-SUFFIX,mp.weixin.qq.com,DIRECT
DOMAIN-SUFFIX,servicewechat.com,DIRECT
DOMAIN-SUFFIX,sh.servicewechat.com,DIRECT
DOMAIN-SUFFIX,video.qq.com,DIRECT
DOMAIN-SUFFIX,finderad.video.qq.com,DIRECT
DOMAIN-SUFFIX,finderyz.video.qq.com,DIRECT
DOMAIN-SUFFIX,finderaly.video.qq.com,DIRECT
DOMAIN-SUFFIX,findera4.video.qq.com,DIRECT
DOMAIN-SUFFIX,findermp.video.qq.com,DIRECT
DOMAIN-SUFFIX,mmbiz.qpic.cn,DIRECT

[Script]
WXAdSniff = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/WXAd/WXAdSniffer_v2.js?v=2

# HTTPS-RESPONSE：响应体关键词扫描（覆盖 URL 不含 ad 的隐形广告）
HTTPS-RESPONSE,fpf.friendfeed.qq.com,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/WXAd/WXAdSniffer_v2.js?v=2
HTTPS-RESPONSE,friendfeed.qq.com,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/WXAd/WXAdSniffer_v2.js?v=2
