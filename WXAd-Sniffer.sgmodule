#!name=微信广告嗅探
#!desc=嗅探朋友圈/公众号评论区/小程序广告API接口结构，通过通知弹出疑似广告请求
#!author=mickeu
#!category=mickeu
#!version=1.0
#!updated=2026-09-02
#!platform=ios
#!tag=

[MITM]
hostname = fpf.friendfeed.qq.com, friendfeed.qq.com, res.wx.qq.com, api.weixin.qq.com, mp.weixin.qq.com, servicewechat.com, sh.servicewechat.com, wx.qq.com, video.qq.com, finderad.video.qq.com, finderyz.video.qq.com, finderaly.video.qq.com, findera4.video.qq.com, findermp.video.qq.com

[Rule]
DOMAIN-SUFFIX,fpf.friendfeed.qq.com,DIRECT
DOMAIN-SUFFIX,friendfeed.qq.com,DIRECT
DOMAIN-SUFFIX,res.wx.qq.com,DIRECT
DOMAIN-SUFFIX,api.weixin.qq.com,DIRECT
DOMAIN-SUFFIX,mp.weixin.qq.com,DIRECT
DOMAIN-SUFFIX,servicewechat.com,DIRECT
DOMAIN-SUFFIX,sh.servicewechat.com,DIRECT
DOMAIN-SUFFIX,video.qq.com,DIRECT
DOMAIN-SUFFIX,finderad.video.qq.com,DIRECT
DOMAIN-SUFFIX,finderyz.video.qq.com,DIRECT
DOMAIN-SUFFIX,finderaly.video.qq.com,DIRECT
DOMAIN-SUFFIX,findera4.video.qq.com,DIRECT
DOMAIN-SUFFIX,findermp.video.qq.com,DIRECT

[Script]
WXAdSniff = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/WXAd/WXAdSniffer.js

# HTTP 请求（视频号 CDN 等明文 HTTP）
HTTP-REQUEST,fpf.friendfeed.qq.com,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/WXAd/WXAdSniffer.js
