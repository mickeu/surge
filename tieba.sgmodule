#!name=🐻 百度贴吧 抓取Cookie
#!desc=仅抓取百度贴吧签到参数（Cookie），不含签到任务。签到脚本需自行在 Surge 脚本功能中添加运行。 | 原作者: @sazs34 | mickeu修改适配Surge
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Action/Baidu_Tieba.png
#!system=ios
#!arguments=cookie_enabled:true
#!arguments-desc=\n1️⃣ cookie_enabled\n\n抓取Cookie开关\n默认 true 开启抓参\n设为 false 关闭抓参\n\n━━━━━━━━━━━━━━━━\n📌 签到脚本手动添加\n\n在 Surge 主配置 [Script] 中添加：\n\n百度贴吧[签到] = type=cron,cronexp="30 0,12 * * *",script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/TieBa/TieBa.js,timeout=600\n\n如需自定义定时，修改 cronexp 即可\n\n━━━━━━━━━━━━━━━━\n修改者：mickeu

[Rule]
# 贴吧API直连
DOMAIN-SUFFIX,c.tieba.baidu.com,DIRECT
DOMAIN-SUFFIX,tiebac.baidu.com,DIRECT

[Script]
# 抓取 Cookie 脚本（cookie_enabled=true 开启抓参，false 关闭）
百度贴吧[Cookie] = type=http-request,pattern=^https?:\/\/(c\.tieba|tiebac)\.baidu\.com\/c\/s\/login,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/TieBa/TieBa.js,argument="cookie_enabled={{{cookie_enabled}}}",timeout=60

[MITM]
hostname = %APPEND% c.tieba.baidu.com, tiebac.baidu.com