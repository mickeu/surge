#!name=讯飞皮肤免费化
#!desc=改写讯飞皮肤详情接口（getres）响应，付费皮肤显示为免费（实验性，App内商店接口为protobuf可能不生效）
#!author=mickeu
#!category=mickeu

[Script]
iflySkinFree = type=http-response, pattern=^https://imeclient\.openspeech\.cn/resource/getres, requires-body=true, script-path=surge_ifly_skin.js

[MITM]
hostname = %APPEND% imeclient.openspeech.cn