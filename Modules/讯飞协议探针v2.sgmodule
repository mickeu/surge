#!name=讯飞协议探针v2（静默回传）
#!desc=捕获讯飞 App 请求/响应回传本机分析（静默无通知，需信任 Surge 根证书；确认后移除）
#!author=mickeu
#!category=mickeu

[Script]
iflyProbeReq = type=http-request, pattern=^https?://, requires-body=true, script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/ifly_probe_req.js?v=2
iflyProbe = type=http-response, pattern=^https?://, requires-body=true, script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/ifly_probe.js?v=2

[MITM]
hostname = %APPEND% *
