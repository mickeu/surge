#!name=讯飞协议探针v5（Uint8Array兼容）
#!desc=捕获讯飞 App 请求/响应含二进制 body 回传本机分析（静默，仅 MITM 讯飞域名）
#!author=mickeu
#!category=mickeu

[Script]
iflyProbeReq = type=http-request, pattern=^https?://(imeclient\.openspeech\.cn|.*\.voicecloud\.cn|ime\.voicecloud\.cn|.*\.xfinfr\.com|.*\.openspeech\.cn|.*\.xfyun\.cn)/, requires-body=true, binary-body-mode=1, script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/ifly_probe_req.js?v=5
iflyProbe = type=http-response, pattern=^https?://(imeclient\.openspeech\.cn|.*\.voicecloud\.cn|ime\.voicecloud\.cn|.*\.xfinfr\.com|.*\.openspeech\.cn|.*\.xfyun\.cn)/, requires-body=true, binary-body-mode=1, script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/ifly_probe.js?v=5

[MITM]
hostname = %APPEND% imeclient.openspeech.cn, *.voicecloud.cn, ime.voicecloud.cn, *.xfinfr.com, *.openspeech.cn, *.xfyun.cn
