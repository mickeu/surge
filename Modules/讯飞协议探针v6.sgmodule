#!name=讯飞协议探针v6（关键接口通知）
#!desc=捕获讯飞 App 请求/响应回传本机；resEnableCheck/vip/order 接口触发时弹通知确认（确认后移除）
#!author=mickeu
#!category=mickeu

[Script]
iflyProbeReq = type=http-request, pattern=^https?://(imeclient\.openspeech\.cn|.*\.voicecloud\.cn|ime\.voicecloud\.cn|.*\.xfinfr\.com|.*\.openspeech\.cn|.*\.xfyun\.cn)/, requires-body=true, binary-body-mode=1, script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/ifly_probe_req.js?v=6
iflyProbe = type=http-response, pattern=^https?://(imeclient\.openspeech\.cn|.*\.voicecloud\.cn|ime\.voicecloud\.cn|.*\.xfinfr\.com|.*\.openspeech\.cn|.*\.xfyun\.cn)/, requires-body=true, binary-body-mode=1, script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/ifly_probe.js?v=6

[MITM]
hostname = %APPEND% imeclient.openspeech.cn, *.voicecloud.cn, ime.voicecloud.cn, *.xfinfr.com, *.openspeech.cn, *.xfyun.cn
