[Script]
iflyProbeReq = type=http-request, pattern=^https?://, requires-body=false, script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/ifly_probe_req.js
iflyProbe = type=http-response, pattern=^https?://, requires-body=true, script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/ifly_probe.js

[MITM]
hostname = %APPEND% *