#!name=Spotify Premium Bypass
#!desc=用 iOS NowPlaying 数据伪装 Spotify API，绕过 Premium 限制
#!author=mickeu
#!category=mickeu

[MITM]
hostname = %APPEND% api.spotify.com, *.spclient.spotify.com, *.spotifycdn.com

[URL Rewrite]
^https://api\.spotify\.com/(.+) http://127.0.0.1:19821/$1 header
^https://[a-z0-9-]*spclient\.spotify\.com/(.+) http://127.0.0.1:19821/$1 header
