#!name=Spotify Premium Bypass
#!desc=用 iOS NowPlaying 数据伪装 Spotify API，绕过 Premium 限制
#!author=mickeu
#!category=mickeu

[MITM]
hostname = api.spotify.com, spclient.wg.spotify.com, open.spotify.com, connect.spotify.com, accounts.spotify.com

[URL Rewrite]
^https://api\.spotify\.com/(.+) http://127.0.0.1:19821/$1 header
^https://spclient\.wg\.spotify\.com/(.+) http://127.0.0.1:19821/$1 header
^https://open\.spotify\.com/(.+) http://127.0.0.1:19821/$1 header
^https://connect\.spotify\.com/(.+) http://127.0.0.1:19821/$1 header
^https://accounts\.spotify\.com/(.+) http://127.0.0.1:19821/$1 header
