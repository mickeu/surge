#!name=Spotify Premium Bypass
#!desc=拦截 Spotify App 流量提取曲目数据，伪装 Web API 响应绕过 Premium 限制
#!author=mickeu
#!category=mickeu

[MITM]
hostname = %APPEND% api.spotify.com, *.spclient.spotify.com

[Script]
# 1. 从 Spotify App 的 Connect API 响应中提取曲目信息
type=http-response,pattern=^https://[a-z0-9-]*spclient\.spotify\.com/.*/player,script-path=https://raw.githubusercontent.com/mickeu/surge/main/spotify-extract.js,requires-body=true

# 2. 灵动歌词调 Web API 时，403 改成 200 + 缓存的曲目数据
type=http-response,pattern=^https://api\.spotify\.com/v1/me/player,script-path=https://raw.githubusercontent.com/mickeu/surge/main/spotify-fake.js,requires-body=true

# 3. /v1/me 返回 premium 状态
type=http-response,pattern=^https://api\.spotify\.com/v1/me$,script-path=https://raw.githubusercontent.com/mickeu/surge/main/spotify-me.js,requires-body=true
