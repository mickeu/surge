#!name=实时油价
#!desc=⛽ 查询全国主要城市实时油价（中文城市名，如：北京、深圳、长沙）
#!author=mickeu
#!category=mickeu
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Server.png
#!homepage=https://github.com/mickeu/surge
#!arguments=CITY:北京
#!arguments-desc=输入城市名（中文，如：北京、深圳、长沙、西安），查看当地实时油价

[Panel]
youjia-cn = script-name=youjia-cn,title="⛽ 实时油价",content="刷新",style=info,update-interval=43200

[Script]
youjia-cn = type=generic,timeout=5,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/youjia-cn.js,argument={{{CITY}}}