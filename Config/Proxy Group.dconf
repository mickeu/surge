[Proxy Group]
# > 主策略组（手动选节点，兜底代理）
PROXY = select, 🇸🇬新加坡, "🇺🇸 美国节点", 🇯🇵日本, icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png, no-alert=0, hidden=0, persistent=0, include-all-proxies=0

# > 苹果服务
AIGC = select, 🇯🇵日本, 🇸🇬新加坡, icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/AI.png, no-alert=0, hidden=0, include-all-proxies=0

# > AI 服务
Telegram = select, "🇺🇸 美国节点", 🇯🇵日本, 🇸🇬新加坡, "🇭🇰 香港节点", icon-url=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Telegram.png, no-alert=0, hidden=0, include-all-proxies=0

# > Telegram
GlobalMedia = select, 🇯🇵日本, 🇸🇬新加坡, "🇭🇰 香港节点", "🇺🇸 美国节点", "🇯🇵 日本节点", "🇸🇬 新加坡节点", icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/DomesticMedia.png, no-alert=0, hidden=0, include-all-proxies=0

# > 流媒体
YouTube = smart, 🇯🇵日本, 🇸🇬新加坡, include-other-group=🌍我的节点, policy-regex-filter=(🇭🇰|🇺🇸|🇯🇵|🇨🇳|🇰🇷|🇸🇬|香港|美国|日本|台湾|韩国|新加坡|Hong|States|Japan|Tai|Korea|Singapore|HK|US|JP|TW|KR|SG), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png, no-alert=0, hidden=0, include-all-proxies=0
🇭🇰 香港节点 = smart, include-other-group=🌍我的节点, policy-regex-filter=(🇭🇰)|(香港)|(Hong)|(HK), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Hong_Kong.png
🇺🇸 美国节点 = smart, include-other-group=🌍我的节点, policy-regex-filter=(🇺🇸)|(美国)|(States)|(US), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/LA.png
🇯🇵 日本节点 = smart, include-other-group=🌍我的节点, policy-regex-filter=(🇯🇵)|(日本)|(Japan)|(JP), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/JP.png
🇸🇬 新加坡节点 = smart, include-other-group=🌍我的节点, policy-regex-filter=(🇸🇬)|(新加坡)|(Singapore)|(SG), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/SG.png
🇰🇷 韩国节点 = smart, include-other-group=🌍我的节点, policy-regex-filter=(🇰🇷)|(韩国)|(Korea)|(\bKR), icon-url=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Country-South_Korea.png, hidden=1
🇨🇳 台湾节点 = smart, include-other-group=🌍我的节点, policy-regex-filter=(🇨🇳)|(台湾)|(Tai)|(TW), icon-url=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Country-China.png, hidden=1

# > 微软服务
🌍我的节点 = smart, policy-path=https://sub.store/download/collection/ZDY?target=Surge, update-interval=0, no-alert=1, hidden=0, icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/MY.png, include-all-proxies=0

# > 游戏平台
Apple = select, DIRECT, PROXY, "🇭🇰 香港节点", "🇺🇸 美国节点", "🇯🇵 日本节点", "🇰🇷 韩国节点", "🇸🇬 新加坡节点", icon-url=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Apple_Arcade.png, no-alert=0, hidden=1, include-all-proxies=0

# > 地区策略组（从订阅中按正则筛选）
Netflix = select, PROXY, "🇭🇰 香港节点", "🇺🇸 美国节点", "🇯🇵 日本节点", "🇰🇷 韩国节点", "🇸🇬 新加坡节点", icon-url=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Netflix.png, no-alert=0, hidden=1, include-all-proxies=0
