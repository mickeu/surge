[Proxy Group]
# > 场景分流（按使用场景匹配；PROXY 为手动选节点兜底代理）
PROXY = select, "🇺🇸 美国节点", "🇯🇵 日本节点", "🇸🇬 新加坡节点", "🇭🇰 香港节点", 🇸🇬新加坡, 🇯🇵日本, icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png, no-alert=0, hidden=0, persistent=0, include-all-proxies=0, category=🎯 场景分流

# > snell 节点会不定期失联（日本 snell 已挂），机场专线做兜底
AIGC = select, "🇺🇸 美国节点", 🇸🇬新加坡, 🇯🇵日本, "🇸🇬 新加坡节点", icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/AI.png, no-alert=0, hidden=0, include-all-proxies=0, category=🎯 场景分流

Telegram = select, "🇺🇸 美国节点", 🇯🇵日本, 🇸🇬新加坡, "🇭🇰 香港节点", icon-url=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Telegram.png, no-alert=0, hidden=0, include-all-proxies=0, category=🎯 场景分流

Apple = select, DIRECT, PROXY, "🇭🇰 香港节点", "🇺🇸 美国节点", "🇯🇵 日本节点", "🇸🇬 新加坡节点", icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Apple.png, no-alert=0, hidden=0, include-all-proxies=0, category=🎯 场景分流

Microsoft = select, DIRECT, PROXY, "🇭🇰 香港节点", "🇺🇸 美国节点", "🇯🇵 日本节点", "🇸🇬 新加坡节点", icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Windows.png, no-alert=0, hidden=0, include-all-proxies=0, category=🎯 场景分流

Game = select, DIRECT, PROXY, "🇭🇰 香港节点", "🇺🇸 美国节点", "🇯🇵 日本节点", "🇸🇬 新加坡节点", icon-url=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Game.png, no-alert=0, hidden=0, include-all-proxies=0, category=🎯 场景分流

# > 影音娱乐（流媒体与娱乐服务）
GlobalMedia = select, 🇯🇵日本, 🇸🇬新加坡, "🇭🇰 香港节点", "🇺🇸 美国节点", "🇯🇵 日本节点", "🇸🇬 新加坡节点", icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/DomesticMedia.png, no-alert=0, hidden=0, include-all-proxies=0, category=🎬 影音娱乐

YouTube = select, "🇭🇰 香港节点", "🇺🇸 美国节点", "🇯🇵 日本节点", "🇸🇬 新加坡节点", "🇹🇼 台湾节点", icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png, no-alert=0, hidden=0, include-all-proxies=0, category=🎬 影音娱乐

Netflix = select, PROXY, "🇭🇰 香港节点", "🇺🇸 美国节点", "🇯🇵 日本节点", "🇸🇬 新加坡节点", icon-url=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Netflix.png, no-alert=0, hidden=0, include-all-proxies=0, category=🎬 影音娱乐

Disney+ = select, PROXY, "🇭🇰 香港节点", "🇺🇸 美国节点", "🇯🇵 日本节点", "🇸🇬 新加坡节点", icon-url=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Disney.png, no-alert=0, hidden=0, include-all-proxies=0, category=🎬 影音娱乐

Spotify = select, PROXY, "🇭🇰 香港节点", "🇺🇸 美国节点", "🇯🇵 日本节点", "🇸🇬 新加坡节点", 🇸🇬新加坡, 🇯🇵日本, icon-url=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Spotify.png, no-alert=0, hidden=0, include-all-proxies=0, category=🎬 影音娱乐

TikTok = select, "🇭🇰 香港节点", "🇺🇸 美国节点", "🇯🇵 日本节点", "🇸🇬 新加坡节点", icon-url=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/TikTok.png, no-alert=0, hidden=0, include-all-proxies=0, category=🎬 影音娱乐

BiliBili = select, DIRECT, "🇭🇰 香港节点", "🇹🇼 台湾节点", icon-url=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Bilibili.png, no-alert=0, hidden=1, include-all-proxies=0, category=🎬 影音娱乐

# > 地区节点（按地域筛选，单独分类）
🌍我的节点 = url-test, policy-path=https://sub.store/download/collection/ZDY?target=Surge, update-interval=0, no-alert=1, hidden=0, icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/MY.png, include-all-proxies=0, category=🌍 地区节点
🇭🇰 香港节点 = smart, include-other-group=🌍我的节点, policy-regex-filter=(🇭🇰)|(香港)|(Hong)|(HK), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/HK.png, no-alert=0, hidden=0, category=🌍 地区节点, include-all-proxies=0
🇺🇸 美国节点 = smart, include-other-group=🌍我的节点, policy-regex-filter=(🇺🇸)|(美国)|(States)|(US), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/LA.png, no-alert=0, hidden=0, include-all-proxies=0, category=🌍 地区节点
🇯🇵 日本节点 = smart, include-other-group=🌍我的节点, policy-regex-filter=(🇯🇵)|(日本)|(Japan)|(JP), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/JP.png, no-alert=0, hidden=0, include-all-proxies=0, category=🌍 地区节点
🇸🇬 新加坡节点 = smart, include-other-group=🌍我的节点, policy-regex-filter=(🇸🇬)|(新加坡)|(Singapore)|(SG), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/SG.png, no-alert=0, hidden=0, include-all-proxies=0, category=🌍 地区节点
🇹🇼 台湾节点 = smart, include-other-group=🌍我的节点, policy-regex-filter=(🇹🇼)|(台湾)|(Tai)|(TW), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/TW.png, no-alert=0, hidden=0, include-all-proxies=0, category=🌍 地区节点
