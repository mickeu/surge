[Proxy Group]
# > 主策略组（手动选节点，兜底代理）
PROXY = select, 🇯🇵日本, 🇸🇬新加坡, icon-url=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Surge.png, no-alert=0, hidden=0, persistent=0

# > 苹果服务
Apple = select, DIRECT, PROXY, "🇭🇰 香港节点", "🇺🇸 美国节点", "🇯🇵 日本节点", "🇰🇷 韩国节点", "🇸🇬 新加坡节点", icon-url=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Apple_Arcade.png, no-alert=0, hidden=0, include-all-proxies=0

# > AI 服务
AIGC = select, 🇯🇵日本, 🇸🇬新加坡, icon-url=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/ChatGPT.png, no-alert=0, hidden=0, include-all-proxies=0

# > Telegram
Telegram = select, 🇯🇵日本, 🇸🇬新加坡, icon-url=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Telegram.png, no-alert=0, hidden=0, include-all-proxies=0

