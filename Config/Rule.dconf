[Rule]
# > 烧饼论坛 sb.sb 强制代理（防止被 Lan.list 的 198.18.0.0/15 fake-IP 规则误判直连而 403）
DOMAIN-SUFFIX,sb.sb,PROXY

# > 广告拦截（blackmatrix7 _All 全量版 + mickeu 补充）
# 直连补充规则集（白名单）必须排在广告规则之前，防止白名单域名被误判广告拦截
# > 规则集下载域名走兜底策略
DOMAIN,cdn.jsdelivr.net,DIRECT // jsdelivr CDN 规则集下载直连
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/Direct_Supplement.list,DIRECT // 直连白名单（必须在广告/Global 之前，防误杀）
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Advertising/Advertising_All.list,REJECT,no-resolve // 广告全量拦截（blackmatrix7）
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/Advertising_Supplement.list,REJECT // 广告拦截补充（blackmatrix7 漏覆盖）

# > LAN 安全 + IPv6 DNS 阻断
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Lan/Lan.list,DIRECT,no-resolve // 局域网直连（NAS/打印机/本地服务，no-resolve 防 DNS 泄露）
# 阻断所有 IPv6 DNS 查询（防止 IPv6 DNS 绕过 Surge DoH 泄漏到运营商）
IP-CIDR6,::/0,REJECT,no-resolve // 强制所有 IPv6 DNS 走 Surge DoH，防止泄漏

# > AI 服务（OpenAI / Claude / Gemini）
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/OpenAI/OpenAI.list,AIGC,no-resolve // OpenAI/ChatGPT 走 AI 策略组
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Claude/Claude.list,AIGC // Claude 走 AI 策略组
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/Gemini.list,AIGC // Gemini 走 AI 策略组（自维护，含 blackmatrix7 原版 + 补充遗漏域名）

# > 苹果服务
# Apple AI 必须走代理，须先于 Apple_All，否则被 Apple_All 拉直连
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/AppleIntelligence.list,AIGC,no-resolve // Apple AI + APNs + IP 段走代理（no-resolve 防止代理域名本地DNS解析泄露）
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/Apple_All.list,Apple,no-resolve // 苹果服务走 Apple 策略组（自维护，补充 Apple Music 流媒体域名，no-resolve 防 DNS 泄露）

# > 微软服务
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Microsoft/Microsoft.list,Microsoft // 微软服务走 Microsoft 策略组

# > 社交平台（Telegram 流量全部走 Telegram 策略组）
PROTOCOL,MTProto,Telegram // MTProto 协议直送 Telegram 组
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/Telegram_All.list,Telegram,no-resolve // Telegram 完整规则集（合并 blackmatrix7 + 补充 CDN 域名，no-resolve 防 DNS 泄露）

# > 游戏平台
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Game/Game.list,Game,no-resolve // 游戏平台走 Game 组（含暴雪战网）

# > 流媒体
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/YouTube/YouTube.list,YouTube,no-resolve // YouTube 走 YouTube 组
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Netflix/Netflix.list,Netflix,no-resolve // Netflix 走 Netflix 组
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Disney/Disney.list,Disney+ // Disney+ 走 Disney+ 组
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Spotify/Spotify.list,Spotify,no-resolve // Spotify 走 Spotify 组
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/TikTok/TikTok.list,TikTok // TikTok 走 TikTok 组
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/BiliBili/BiliBili.list,BiliBili,no-resolve // B站走 BiliBili 组
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/ChinaMedia/ChinaMedia.list,DIRECT,no-resolve // 国内流媒体直连（腾讯/爱奇艺/优酷等）
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/GlobalMedia/GlobalMedia.list,GlobalMedia,no-resolve // 境外流媒体兜底走 GlobalMedia 组

# > 补充国内直连（误走代理的国内业务域名，必须在 Global_All 之前）
# > 以下为 Direct_Supplement.list 中已包含的冗余行，保留以防规则集加载异常时兜底
DOMAIN-SUFFIX,wxgateway.com,DIRECT // 微信数据上报域名，漏走代理修复
DOMAIN-SUFFIX,servicewechat.com,DIRECT // 微信小程序服务域名，漏走代理修复
DOMAIN-SUFFIX,huaweicloud.com,DIRECT // 华为云登录/控制台，漏走代理修复

# > 视频采集站/资源站域名直连（no-resolve 后不再靠 IP-CIDR 匹配，统一收进 Video_RESOURCE.list 维护）
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/Video_RESOURCE.list,DIRECT // 视频采集站/资源站直连（mickeu 自维护）

# > 网络信息模块数据源直连（xream net-lsp-x，spcn 国内 IP 查询）
DOMAIN-SUFFIX,speedtest.cn,DIRECT // speedtest.cn 直连（网络信息面板数据源）

# > 境外常规网站代理（Global_All 综合大表，覆盖所有未被以上规则匹配的境外域名/IP）
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Global/Global_All.list,PROXY,no-resolve // 境外网站代理兜底（综合大表，no-resolve 防 DNS 泄露）

# > 🇨🇳 中国大陆直连（四层防线，逐层收紧，确保无泄漏）
# 第一层：ChinaMax_Domain 域名白名单（精准匹配国内域名，优先于 IP 规则）
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/ChinaMax/ChinaMax_Domain.list,DIRECT,no-resolve // 国内域名白名单（精准匹配，先于 IP 规则）
# 第二层：ChinaMax 综合大表（域名 + IP-CIDR 全覆盖，捕获国内 IP 段流量）
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/ChinaMax/ChinaMax.list,DIRECT,no-resolve // 国内 IP 段全覆盖（含域名 11万+ IP 8千+，no-resolve 防 DNS 泄露）
# 第三层：GetSomeFries ASN China（按自治域匹配，补全 ChinaMax 仅 1 条 ASN 的缺口，覆盖电信/联通/移动骨干网全量）
RULE-SET,https://raw.githubusercontent.com/VirgilClyne/GetSomeFries/main/ruleset/ASN.China.list,DIRECT,no-resolve // 中国 ASN 直连（5076 条自治域，骨干网全覆盖，no-resolve 防 DNS 泄露）

# > GeoIP 中国大陆 IP 兜底（no-resolve 跳过已匹配流量的 DNS 解析，减少延迟）
GEOIP,CN,DIRECT,no-resolve // 中国大陆 IP 兜底直连

# > HTTP 流量兜底直连（视频采集站几乎全是 HTTP，HTTPS 已被前面规则匹配走代理）
URL-REGEX,^http://,DIRECT // 未被以上规则匹配的 HTTP 流量走直连（视频采集站兜底）

# > Final 规则（DNS 查询失败时也走 Final）
FINAL,PROXY,dns-failed // 未匹配流量走代理兜底
