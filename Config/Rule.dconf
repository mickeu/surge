[Rule]
# 广告拦截（白名单必须先于广告，防误杀）
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/Direct_Supplement.list,DIRECT
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Advertising/Advertising_All.list,REJECT,no-resolve
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/Advertising_Supplement.list,REJECT

# 强制代理补充（先于 Lan，防 fake-IP 段被误判直连）
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/Proxy_Supplement.list,PROXY

# 局域网直连
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Lan/Lan.list,DIRECT,no-resolve

# AI 服务
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/OpenAI/OpenAI.list,AIGC,no-resolve
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Claude/Claude.list,AIGC
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/Gemini.list,AIGC

# 苹果服务（AI/海外服务先于 Apple_All，否则被拉直连）
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/AppleIntelligence.list,AIGC,no-resolve
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/Apple_Services.list,AIGC,no-resolve
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/Apple_All.list,Apple,no-resolve

# 微软服务
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Microsoft/Microsoft.list,Microsoft

# Telegram（MTProto 协议直送 + 域名规则）
PROTOCOL,MTProto,Telegram
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/Telegram_All.list,Telegram,no-resolve

# 游戏平台
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Game/Game.list,Game,no-resolve

# 流媒体
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/YouTube/YouTube.list,YouTube,no-resolve
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Netflix/Netflix.list,Netflix,no-resolve
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Disney/Disney.list,Disney+
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Spotify/Spotify.list,Spotify,no-resolve
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/TikTok/TikTok.list,TikTok
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/BiliBili/BiliBili.list,BiliBili,no-resolve
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/ChinaMedia/ChinaMedia.list,DIRECT,no-resolve
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/GlobalMedia/GlobalMedia.list,GlobalMedia,no-resolve

# 视频资源站直连
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/Video_RESOURCE.list,DIRECT

# 境外网站代理兜底
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Global/Global_All.list,PROXY,no-resolve

# 中国大陆直连（域名、ASN、IP 三层兜底）
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/ChinaMax/ChinaMax_Domain.list,DIRECT,no-resolve
RULE-SET,https://raw.githubusercontent.com/VirgilClyne/GetSomeFries/main/ruleset/ASN.China.list,DIRECT,no-resolve
GEOIP,CN,DIRECT,no-resolve

# 兜底代理（DNS 查询失败也走）
FINAL,PROXY,dns-failed