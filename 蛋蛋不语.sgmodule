#!name=蛋蛋不语VIP解锁
#!desc=蛋蛋不语 - 解锁会员（1.0.2 起主后端改用 https://supabase.opengl.top/，备用 sb.danboxingqiu.cn，故同时覆盖 IP 与两个域名）
#!author=mickeu
#!category=mickeu

[Rule]
RULE-SET,https://raw.githubusercontent.com/mickeu/surge/main/Rulesets/DanDan.list,DIRECT,no-resolve // 蛋蛋不语域名直连（no-resolve 防 DNS 泄露）

[Script]
蛋蛋不语VIP解锁-IP = type=http-response,pattern=^https?:\/\/38\.76\.202\.248:8000\/.*profiles.*,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/DanDan/dandanvip_unlock.js?v=3,requires-body=1,max-size=1048576,binary-body-mode=0,timeout=10
蛋蛋不语VIP解锁-域名 = type=http-response,pattern=^https?:\/\/[a-z0-9.-]*(danboxingqiu\.cn|opengl\.top)\/.*profiles.*,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/DanDan/dandanvip_unlock.js?v=3,requires-body=1,max-size=1048576,binary-body-mode=0,timeout=10

[MITM]
hostname = %APPEND% 38.76.202.248:8000, supabase.opengl.top, opengl.top, *.opengl.top, sb.danboxingqiu.cn, danboxingqiu.cn, *.danboxingqiu.cn
