[Script]
拼多多广告屏蔽 = type=http-response,pattern=^https://[^/]*pinduoduo\.com/.*,requires-body=true,max-size=5242880,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/PDD-AdBlock-v5.js

[MITM]
hostname = %APPEND% *.pinduoduo.com
