#!name=Local Device Loopback
#!desc=将 10.7.0.1 纳入 Surge VIF 接管，供本机开发者工具使用（LocalDevVPN 场景）。参数可开关 IPv6 VIF。
#!author=mickeu
#!category=mickeu
#!arguments=IPV6_VIF
#!arguments-desc=IPv6 VIF 开关：不填/留空 = 关闭（ipv6-vif=disabled 生效，默认）｜填 # = 开启（该行被注释掉，恢复系统默认）。

[General]
{{{IPV6_VIF}}}ipv6-vif = disabled // Leave empty to disable IPv6 on VIF (default); fill # before this line to re-enable IPv6 on VIF
tun-included-routes = %INSERT% 10.7.0.1/32
