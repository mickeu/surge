#!name=Xiaoxiong OpenAI 反代（多账号轮询）
#!desc=把商汤 Xiaoxiong（小浣熊）包装成 OpenAI 兼容 API，支持多账号轮询负载均衡：accounts 填多个「手机号:密码」用竖线分隔，每账号独立 token 缓存与自动续期；附每日批量签到（串行防风控）+ 面板手动签到。账号数不限。
#!author=mickeu
#!category=mickeu
#!arguments=nation:86,accounts:none,phones:none,password:none,cron:12 0 * * *
#!arguments-desc=两种填法任选其一：① 每账号独立密码：accounts 填「手机1:密码1|手机2:密码2|...」；② 所有账号同密码：phones 填「手机1|手机2|...」（竖线分隔，数量不限），password 填统一密码。不用的项保持 none。nation 区号默认 86；cron 为签到时间（cron 表达式，五段：分 时 日 月 周，设备本地时区，默认每天 0:12）。改完参数需 Reload Profile 生效。

[MITM]
hostname = %APPEND% xiaohuanxiong.com

[Script]
Xiaoxiong 多账号反代 = type=http-request,pattern=^https://xiaohuanxiong\.com/v1/(acc\d+/)?(chat/completions|models|checkin|probe),requires-body=true,max-size=10485760,engine=webview,timeout=600,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/raccoon-openai-multi.js?v=3,argument="nation={{{nation}}}&accounts={{{accounts}}}&phones={{{phones}}}&password={{{password}}}"
Xiaoxiong 多账号签到 = type=cron,cronexp="{{{cron}}}",wake-system=1,engine=webview,timeout=600,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/raccoon-openai-multi.js?v=3,argument="nation={{{nation}}}&accounts={{{accounts}}}&phones={{{phones}}}&password={{{password}}}"
Xiaoxiong 签到面板 = type=generic,timeout=120,engine=webview,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/raccoon-openai-multi.js?v=3,argument="nation={{{nation}}}&accounts={{{accounts}}}&phones={{{phones}}}&password={{{password}}}"

[Panel]
Xiaoxiong 签到面板 = script-name=Xiaoxiong 签到面板,title="🦝 Xiaoxiong 签到",content="点此手动签到",style=info,update-interval=0