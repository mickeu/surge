#!name=百度贴吧签到整合版
#!desc=🔄 整合百度贴吧抓Cookie + 自动签到，支持定时参数，一个模块搞定
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Action/Baidu_Tieba.png
#!system=ios
#!author=mickeu
#!category=mickeu
#!arguments=cookie_enabled:true,cron:30 0 * * *
#!arguments-desc=\n📌 参数说明\n\n1️⃣ cookie_enabled 抓Cookie开关\n默认 true 开启抓参；设 false 关闭抓参\n打开百度贴吧App点"我的"自动抓到Cookie，成功后弹通知，再关掉即可\n\n2️⃣ cron 签到定时\ncron 表达式，默认 "30 0 * * *"（每天0:30签到）\n\n修改者：mickeu

[Rule]
# 贴吧API直连
DOMAIN-SUFFIX,c.tieba.baidu.com,DIRECT
DOMAIN-SUFFIX,tiebac.baidu.com,DIRECT

[Script]
# 抓 Cookie（http-request，打开App点"我的"自动抓Cookie）
百度贴吧[Cookie] = type=http-request,pattern=^https?:\/\/(c\.tieba|tiebac)\.baidu\.com\/c\/s\/login,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/TieBa/TieBa.js,argument="cookie_enabled={{{cookie_enabled}}}",timeout=60
# 签到（cron 定时任务，用同一个 TieBa.js，靠 $request 自动分流到签到逻辑）
百度贴吧签到 = type=cron,cronexp="{{{cron}}}",script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/TieBa/TieBa.js,timeout=600,wake-system=1
# 面板手动签到（点面板刷新即执行签到，结果直接显示在面板）
百度贴吧签到面板 = type=generic,timeout=600,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/TieBa/TieBaPanel.js,argument="cookie_enabled={{{cookie_enabled}}}"

[Panel]
百度贴吧签到面板 = script-name=百度贴吧签到面板,title="🀄 贴吧签到",content="拉取最新通知",style=info,update-interval=0

[MITM]
hostname = %APPEND% c.tieba.baidu.com, tiebac.baidu.com