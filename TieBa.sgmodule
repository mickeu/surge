#!name=百度贴吧签到整合版
#!desc=🔄 整合百度贴吧抓Cookie + 自动签到 + 面板手动签到，一个模块搞定
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Action/Baidu_Tieba.png
#!system=ios
#!author=mickeu
#!category=mickeu
#!arguments=cookie_enabled:true
#!arguments-desc=\n📌 参数说明\n\n1️⃣ cookie_enabled 抓Cookie开关\n默认 true 开启抓参；设 false 关闭抓参\n打开百度贴吧App点"我的"自动抓到Cookie，成功后弹通知，再关掉即可\n\n⏰ 签到定时：默认每天 0:30，如需修改请在 Surge「脚本」界面直接改「百度贴吧签到」的 cronexp\n\n修改者：mickeu

[Rule]
# 贴吧API直连（签到列表/签到接口均走 tieba.baidu.com 主域）
DOMAIN-SUFFIX,tieba.baidu.com,DIRECT
DOMAIN-SUFFIX,tiebac.baidu.com,DIRECT

[Script]
# 抓 Cookie（http-request，打开App点"我的"自动抓Cookie）
百度贴吧[Cookie] = type=http-request,pattern=^https?:\/\/(c\.tieba|tiebac)\.baidu\.com\/c\/s\/login,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/TieBa/TieBa.js?v=2,argument="cookie_enabled={{{cookie_enabled}}}",timeout=60
# 签到（cron 定时任务，用同一个 TieBa.js，靠 $request 自动分流到签到逻辑；定时请在 Surge 脚本界面直接改 cronexp）
百度贴吧签到 = type=cron,cronexp="30 0 * * *",script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/TieBa/TieBa.js?v=2,timeout=600,wake-system=true
# 面板签到（点面板即签到，详情走通知，面板显示固定图标）
百度贴吧签到面板 = type=generic,timeout=600,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/TieBa/TieBaPanel-v4.js?v=2

[Panel]
百度贴吧签到面板 = script-name=百度贴吧签到面板,title="百度贴吧签到",content="点击签到",style=info,update-interval=0

[MITM]
hostname = %APPEND% c.tieba.baidu.com, tiebac.baidu.com