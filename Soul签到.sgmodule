#!name=Soul 抓包分析
#!desc=Soul App API 抓包分析（MITM 解密 + 请求捕获）｜分析阶段使用｜mickeu
#!icon=https://img.soulapp.cn/header/ic_launcher.png
#!system=ios

[Script]
# 捕获 Soul API 请求（http-request，打开 App 自动触发）
Soul抓包 = type=http-request,pattern=^https?:\/\/api\.soulapp\.cn\/,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/Soul/soul_capture.js,timeout=10

[MITM]
hostname = %APPEND% api.soulapp.cn, soulapp.cn, soulsmile.cn, api-h5.soulsmile.cn, api-h5.soulapp.cn, themis.soulapp.cn