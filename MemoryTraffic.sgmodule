#!name=内存流量
#!desc=本机流量 + Tailscale 入站设备流量监控面板。多台设备按设备名独立统计（dev1~dev5），API 地址/密码可配置
#!author=mickeu
#!category=mickeu
#!arguments=dev1:iphone-xr,dev2:选填,dev3:选填,dev4:选填,dev5:选填,api_host:127.0.0.1,api_port:6171,api_key:surgetest
#!arguments-desc=\n📌 参数说明\n\n1️⃣ dev1～dev5 各台 Tailscale 设备名\n   填 Tailscale 中显示的设备名称（deviceName），多台设备各占一个参数口，留空则不显示\n   设备名可在 console.tailscale.com/admin/machines 查看或改名\n\n2️⃣ api_host HTTP API 地址（默认 127.0.0.1）\n3️⃣ api_port HTTP API 端口（默认 6171）\n4️⃣ api_key HTTP API 密码（默认 surgetest）\n\n⚠️ 填完参数后必须 Reload Profile（Surge 配置→Reload Profile）让脚本重新加载参数

[Panel]
MemoryTraffic = title="内存流量",content="正在获取数据...",style=info,script-name=memory-traffic,update-interval=10

[Script]
memory-traffic = type=generic,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/MemoryTraffic.js?v=3,argument=dev1={{{dev1}}}&dev2={{{dev2}}}&dev3={{{dev3}}}&dev4={{{dev4}}}&dev5={{{dev5}}}&api_host={{{api_host}}}&api_port={{{api_port}}}&api_key={{{api_key}}}