#!name=内存和流量实时监控
#!desc=内存 + 本机流量 + Tailscale 运行状态面板。展示会话状态、本机、DERP、出口、入站流量、在线设备与直连/中继分布；入站设备自动识别，无需填写设备名
#!author=mickeu
#!category=mickeu
#!arguments=api_host:127.0.0.1,api_port:6171,api_key:surgetest
#!arguments-desc=\n📌 参数说明\n\n1️⃣ api_host / api_port / api_key\n   仅用于读取 Surge 的内存与接口计数（/v1/metrics，纯文本）。\n   请求列表与 Tailscale 运行时都走引擎内置 $httpAPI 直连，不经过这三个参数，也不产生回环请求。\n\n2️⃣ 无需配置 Tailscale\n   Tailscale 策略名自动从当前 Profile 的「xxx = tailscale」行识别；\n   入站设备名单自动取自该策略运行时的 peer 列表，新增设备上线即出现，不必再编辑参数。\n   Tailscale 策略改名或换配置后，脚本会自动重新探测。\n\n⚠️ 必须开启 MCP\n   Surge → 设置 → HTTP API → 打开「MCP」（配置项 http-api-mcp = true）。\n   Tailscale 段的数据只能经 MCP 工具读取；未开启时该段显示「不可用」，其余指标正常。\n\n⚠️ 填完参数后必须 Reload Profile 让脚本重新加载参数。\n\n\n⚠️ 重要注意事项\n\nTailscale 入站设备（如 iphone-xr）通过本机上网时，若访问被本机 MITM 的域名\n（如 weatherkit.apple.com 苹果天气），会因不信任 Surge 的 MITM CA 证书而连接失败\n（典型现象：入站设备的天气打不开）。\n解决方法：必须安装并信任【接受入站的那台 Surge（本机）】的 MITM CA 证书\n（不能是其他设备导出的证书）。在本机 Surge → 设置 → MITM → 导出描述文件（.mobileconfig），\n安装到入站设备后，到「设置 → 通用 → 关于本机 → 证书信任设置」开启完全信任。\n否则被 MITM 的域名在入站设备上会无法访问。

[Panel]
MemoryTraffic = title="内存和流量实时监控",content="正在获取数据...",style=info,script-name=memory-traffic,update-interval=10

[Script]
# 面板脚本：面板可见时刷新显示（只在面板显示时才被调度）
memory-traffic = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/MemoryTraffic.js?v=13,argument=mode=panel&api_host={{{api_host}}}&api_port={{{api_port}}}&api_key={{{api_key}}}
