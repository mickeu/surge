#!name=中国联通 每日签到
#!desc=中国联通 App 每日自动签到（领话费红包 + 积分）｜mickeu
#!system=ios

[Script]
# 捕获联通 App 认证信息（http-request，打开 App 自动触发）
联通签到[cookie] = type=http-request,pattern=^https?:\/\/[a-z0-9-]+\.(10010|chinaunicom)\.(com|cn)\/,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/Unicom/unicom_sign.js,timeout=10
# 每日自动签到（cron，默认每天9点执行）
联通签到 = type=cron,cronexp=0 9 * * *,wake-system=1,timeout=30,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/Unicom/unicom_sign.js

[MITM]
hostname = %APPEND% *.10010.com, *.10010.cn, *.chinaunicom.cn