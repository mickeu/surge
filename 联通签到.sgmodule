#!name=联通签到
#!desc=中国联通每日签到（抓Cookie + 自动签到）
#!system=ios

[Script]
联通签到[cookie] = type=http-request,pattern=^https?:\\/\\/[a-z0-9-]+\\.10010\\.(com|cn)\\/,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/Unicom/unicom_sign_v2.js,timeout=30
联通签到 = type=cron,cronexp=0 9 * * *,wake-system=1,timeout=30,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/Unicom/unicom_sign_v2.js

[MITM]
hostname = %APPEND% *.10010.com, *.10010.cn, *.chinaunicom.cn