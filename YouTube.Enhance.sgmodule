#!name=Youtube (Music) Enhance
#!desc=适用于 Youtube & Youtube Music（mickeu 修改版：exit node/tailnet 入站设备放行，避免 UDP REJECT 导致 tailnet 设备打不开 YouTube）
#!author=mickeu
#!category=mickeu

[Rule]
# exit node（tailnet 段）入站设备放行 YouTube，避免 UDP REJECT 导致 QUIC 回退失败
AND,((SRC-IP,100.64.0.0/10),(DOMAIN-SUFFIX,googlevideo.com)),YouTube
AND,((SRC-IP,100.64.0.0/10),(DOMAIN,youtubei.googleapis.com)),YouTube
# 本机 YouTube 强制走 TCP（QUIC 无法被去广告/脚本处理）
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad data-type=text data= status-code=200

[Script]
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js,argument="{\"lyricLang\":\"off\",\"captionLang\":\"off\",\"blockUpload\":true,\"blockImmersive\":true,\"blockShorts\":true,\"debug\":false}"

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
