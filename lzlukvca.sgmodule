#!name=黄豆短剧 lzlukvca 金币+会员剧集解锁
#!desc=解锁 lzlukvca.cc 金币/会员剧集
#!system=ios
#!author=mickeu
#!homepage=https://github.com/mickeu/surge
#!update-url=https://raw.githubusercontent.com/mickeu/surge/main/lzlukvca.sgmodule

[Script]
lzlukvca-req = type=http-request, pattern=^https://lzlukvca\.cc/api/(drama/(detail|play|doBuy)|user/(info|recharge)), requires-body=true, binary-body-mode=true, script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/lzlukvca/lzlukvca.js
lzlukvca-resp = type=http-response, pattern=^https://lzlukvca\.cc/api/(drama/(detail|play|doBuy)|user/(info|recharge)), requires-body=true, binary-body-mode=true, script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/lzlukvca/lzlukvca.js

[MITM]
hostname = lzlukvca.cc