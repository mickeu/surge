#!name=被🐶追的猫
#!desc=显示 AI 策略组状态（节点数、当前策略），点击可修改监控策略组名

[Script]
AI-Policy = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/mickeu/surge/main/%E8%A2%AB%F0%9F%90%B6%E8%BF%BD%E7%9A%84%E7%8C%AB.js

[Panel]
被🐶追的猫 = script-name=AI-Policy,title="被🐶追的猫",content="点击刷新",style=info,update-interval=0,script-param=AIGC
