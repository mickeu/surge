#!name=PingMe 抓取Cookie
#!desc=仅抓取PingMe签到参数（Cookie），不含签到任务。签到脚本需自行在 Surge 脚本功能中添加运行。 | 原作者: @ZenMoFiShi & 奶思 | mickeu修改适配Surge并添加参数开关
#!icon=https://raw.githubusercontent.com/axhani/icon/refs/heads/main/pingme&wetalk.png
#!system=ios
#!arguments=capture:true
#!arguments-desc=\n1️⃣ capture\n\n抓取Cookie开关\n默认 true 开启抓参\n设为 false 关闭抓参\n\n每运行一次签到脚本，自动生成随机设备ID，防止被检测\n\n━━━━━━━━━━━━━━━━\n📌 签到脚本手动添加说明\n\n在 Surge 配置文件 [Script] 中添加以下内容：\n\nPingMe签到 = type=cron,cronexp="0 */3 * * *",script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/PingMe/PingMeSignin.js,timeout=300\n\n如需自定义定时，修改 cronexp 即可\n\n━━━━━━━━━━━━━━━━\n修改者：mickeu

[Script]
# 抓取 Cookie 脚本（参数 capture=true 开启抓参，capture=false 关闭）
PingMe获取签到参数 = type=http-request,pattern=^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus,script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/PingMe/pingme_capture.js?t=3,argument="capture={{{capture}}}",timeout=60

[MITM]
# 模块模式下，%APPEND% 关键字才会生效
hostname = %APPEND% api.pingmeapp.net