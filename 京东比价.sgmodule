#!name=京东比价
#!desc=首次使用需安装慢慢买应用，之后点击进入[我的]页面以捕获Cookie，捕获成功后方可在商品详情页面查看比价内容。
#!author=wf021325, githubdulong, mw418（原作者）；mickeu（脚本自托管）
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png
#!category=mickeu
#!openUrl=https://apps.apple.com/app/id414245413
#!tag=功能增强
#!homepage=https://hub.kelee.one
#!date=2026-11-25 23:10:00

[Rule]
// 慢慢买接口为国内服务，脚本串行 3-4 次请求，走代理会拖到超时
DOMAIN-SUFFIX,manmanbuy.com,DIRECT

[Script]
捕获令牌 = type=http-request, pattern=^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$, script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/JD/JD_Price.js?v=2, requires-body=true, max-size=1048576, timeout=10
京东比价 = type=http-response, pattern=^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, script-path=https://raw.githubusercontent.com/mickeu/surge/main/Scripts/JD/JD_Price.js?v=2, requires-body=true, max-size=1048576, timeout=30

[MITM]
hostname = %APPEND% in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com
